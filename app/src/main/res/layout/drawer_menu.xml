<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nav_view_container"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:background="@color/white"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Drawer Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/brand_navy"
            android:padding="24dp"
            android:paddingTop="48dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/khusimotors"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/btn_close_drawer"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_close"
                    android:padding="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="@color/white"
                    xmlns:app="http://schemas.android.com/apk/res-auto" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Khushi Motors"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trusted Car Care Since 2009"
                android:textColor="#AAAACC"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Menu Items -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/menu_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="🏠  Home"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:background="@drawable/bg_menu_item_selected"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/menu_services"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="🔧  Services"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:background="@drawable/bg_menu_item"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/menu_about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="ℹ️  About Us"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:background="@drawable/bg_menu_item"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/menu_contact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="📞  Contact"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:background="@drawable/bg_menu_item"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/menu_booking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="📋  My Booking"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:background="@drawable/bg_menu_item"
                android:layout_marginBottom="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginVertical="16dp" />

            <Button
                android:id="@+id/menu_call_drawer"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_red_button_rounded"
                android:text="📞 Call: 6397759757"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="© 2026 Khushi Motors"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            android:textAlignment="center"
            android:padding="16dp" />

    </LinearLayout>
</LinearLayout>

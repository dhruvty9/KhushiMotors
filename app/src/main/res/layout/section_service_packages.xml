<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="24dp">

    <TextView
        style="@style/SectionLabel"
        android:text="SERVICE PACKAGES" />

    <TextView
        style="@style/SectionTitle"
        android:text="Service Packages"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Complete service transparency — know exactly what your car gets."
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp" />

    <!-- Basic Service Package -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Basic Service"
                    android:textColor="@color/brand_navy"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="POPULAR"
                    android:background="@drawable/bg_badge_orange"
                    android:textColor="@color/badge_text"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Essential maintenance for smooth daily driving"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✅  Engine Oil — Replaced" android:textColor="@color/text_primary" android:textSize="14sp" android:layout_marginBottom="6dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✅  Oil Filter — Replaced" android:textColor="@color/text_primary" android:textSize="14sp" android:layout_marginBottom="6dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✅  Air Filter — Cleaned" android:textColor="@color/text_primary" android:textSize="14sp" android:layout_marginBottom="6dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✅  Coolant — Top Up" android:textColor="@color/text_primary" android:textSize="14sp" android:layout_marginBottom="6dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✅  Wiper Fluid — Top Up" android:textColor="@color/text_primary" android:textSize="14sp" android:layout_marginBottom="6dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✅  Car Wash — Included" android:textColor="@color/text_primary" android:textSize="14sp" android:layout_marginBottom="16dp" />
            <Button
                android:id="@+id/btn_book_basic_service"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_red_button_rounded"
                android:text="Book Basic Service"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:textSize="15sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Standard Service Package -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeColor="@color/brand_navy"
        app:strokeWidth="2dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Standard Service"
                android:textColor="@color/brand_navy"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Comprehensive service for better performance"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✅  Engine Oil — Replaced" android:textColor="@color/text_primary" android:textSize="14sp" android:layout_marginBottom="6dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✅  Air Filter — Replaced" android:textColor="@color/text_primary" android:textSize="14sp" android:layout_marginBottom="6dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✅  Oil Filter — Replaced" android:textColor="@color/text_primary" android:textSize="14sp" android:layout_marginBottom="6dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✅  Wiper Fluid — Replaced" android:textColor="@color/text_primary" android:textSize="14sp" android:layout_marginBottom="6dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✅  Coolant — Top Up" android:textColor="@color/text_primary" android:textSize="14sp" android:layout_marginBottom="6dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✅  Brake Fluid — Top Up" android:textColor="@color/text_primary" android:textSize="14sp" android:layout_marginBottom="16dp" />
            <Button
                android:id="@+id/btn_book_standard_service"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_button_outline_navy"
                android:text="Choose Standard"
                android:textColor="@color/brand_navy"
                android:textAllCaps="false"
                android:textSize="15sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Premium Service Package -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/brand_navy"
            android:padding="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Premium Service"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BEST VALUE"
                    android:background="@drawable/bg_badge_gold"
                    android:textColor="#7B5800"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Complete premium care for maximum safety"
                android:textColor="#AAAACC"
                android:textSize="13sp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✅  Engine Oil — Replaced" android:textColor="@color/white" android:textSize="14sp" android:layout_marginBottom="6dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✅  Air Filter — Replaced" android:textColor="@color/white" android:textSize="14sp" android:layout_marginBottom="6dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✅  Oil Filter — Replaced" android:textColor="@color/white" android:textSize="14sp" android:layout_marginBottom="6dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✅  Brake Oil — Replaced" android:textColor="@color/white" android:textSize="14sp" android:layout_marginBottom="6dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✅  Wiper Fluid — Replaced" android:textColor="@color/white" android:textSize="14sp" android:layout_marginBottom="6dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✅  Coolant — Top Up" android:textColor="@color/white" android:textSize="14sp" android:layout_marginBottom="16dp" />
            <Button
                android:id="@+id/btn_book_premium_service"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_red_button_rounded"
                android:text="Go Premium"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:textSize="15sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="All packages include free vehicle pickup &amp; drop. GST applicable on final bill."
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textAlignment="center"
        android:layout_marginTop="12dp" />

</LinearLayout>
